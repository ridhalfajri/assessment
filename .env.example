# Supabase — ambil nilainya dari Dashboard Supabase → Project Settings → API.
# Salin file ini ke .env.local lalu isi nilai aslinya. JANGAN commit .env.local.

# URL project Supabase (dipakai client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (dipakai client & server; aman untuk browser karena dibatasi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY (API route / server component).
# Jangan pernah di-prefix NEXT_PUBLIC_ atau dipanggil dari client component.
SUPABASE_SERVICE_ROLE=your-service-role-key
